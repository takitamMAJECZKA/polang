// Test optional parentheses for functions

funkcja dodaj a, b {
    zwroc a + b;
}

funkcja powitaj imie {
    pisz "Witaj " + imie;
}

funkcja bezArgumentow {
    pisz "Bez argumentow";
}

pisz dodaj(2, 3);
powitaj("Kasia");
bezArgumentow();

// Test optional parentheses for catch (already tested but good to include)
sprobuj {
    rzuc "Wyjatek";
} zlap e {
    pisz "Zlapano: " + e;
}

sprobuj {
    rzuc "Wyjatek 2";
} zlap (e) {
    pisz "Zlapano (nawiasy): " + e;
}
